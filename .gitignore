# ---- 后端 / Maven ----
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# 运行时本地数据（SQLite 数据库、日志、上传图片）
data/

# ---- 前端 / Electron ----
frontend/node_modules/
frontend/dist/
